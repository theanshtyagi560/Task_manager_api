      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/tasks/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "tasks",
            ""
          ]
        },
        "description": "Validates that endpoints reject unauthenticated requests with HTTP 401 Unauthorized."
      },
      "response": []
    }
  ]
}
